# Laravel API
LARAVEL_API_URL=http://localhost:8000/api
API_SECRET_KEY=your-secret-key-here
API_TIMEOUT=10

# RTSP / CCTV (TP-Link Tapo C200)
RTSP_URL=rtsp://sakti007:azzam007@192.168.0.111:554/stream1
RTSP_TIMEOUT=5
SNAPSHOT_QUALITY=95

# Face Recognition
FACE_TOLERANCE=0.55
FACE_ENCODINGS_PATH=./face_data/encodings.json

# RFID Reader
RFID_PORT=COM3
RFID_BAUDRATE=9600
RFID_SIMULATION_MODE=true

# Face Verification Service
FACE_SERVICE_PORT=5001

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/sakti.log
